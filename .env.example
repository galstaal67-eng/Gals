# Application
APP_NAME="SOX System"
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://sox:sox@localhost:5432/sox

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Entra ID (SSO for internal consultants) — populate in real env
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:8000/api/v1/auth/sso/entra/callback

# Azure Blob Storage (evidence files) — populate in real env
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER=sox-evidence

# i18n
DEFAULT_LOCALE=he
SUPPORTED_LOCALES=he,en
